    pages = {}
    running = set()
    dots = {}
    timers = {}
    controls = []
    selected = None
    selected_role = None

    def show_session_folder(role):
        target = named_session(tmux_role(role)) if role else None
        path = session_pane_path(target)
        if path is None:
            active_folder.hide()
            return
        chosen = chooser.get_filename()
        different = chosen and os.path.realpath(chosen) != os.path.realpath(path)
        folder_name = Path(path).name or "/"
        active_folder.set_text(("Açık oturum başka klasörde: " if different else "Açık oturum: ")
                               + folder_name)
        active_folder.set_tooltip_text(path)
        active_folder.show()

    chooser.connect("file-set", lambda *_: show_session_folder(selected_role))

    def select_button(button):
        nonlocal selected, selected_role
        if selected is not None:
            selected.get_style_context().remove_class("aa-selected")
        if button is not None:
            button.get_style_context().add_class("aa-selected")
        selected = button
        selected_role = next((role for role, item in buttons_by_role.items() if item is button), None)
        show_session_folder(selected_role)

    buttons_by_role = {}

    def indicate(role, state):
        color, detail = STATES[state]
        dot = dots[role]
        dot.set_markup(f'<span foreground="{color}">●</span>')
        dot.set_tooltip_text(detail)

    def clear_activity_timer(role):
        pending = timers.pop(role, None)
        if pending is not None:
            GLib.source_remove(pending)

    def terminal_activity(_terminal, role):
        if role not in running:
            return
        indicate(role, "active")
        clear_activity_timer(role)

        def wake():
            timers.pop(role, None)
            if role in running:
                indicate(role, "ready")
            return GLib.SOURCE_REMOVE

        timers[role] = GLib.timeout_add(900, wake)

    def process_closed(role):
        running.discard(role)
        if selected_role == role:
            active_folder.hide()
        clear_activity_timer(role)
        indicate(role, "closed")
    status = Gtk.Label(xalign=0, wrap=True)
    status.get_style_context().add_class("aa-caption")
    status.set_max_width_chars(25)

    def show_reminder(_button):
        text = session_reminder(atolye_sessions())
        dialog = Gtk.Dialog(title="Oturum hatırlatıcısı", transient_for=win, modal=True)
        dialog.set_default_size(540, 385)
        dialog.add_button("Kapat", Gtk.ResponseType.CLOSE)
        dialog.add_button("Panoya kopyala", Gtk.ResponseType.OK)
        area = dialog.get_content_area()
        area.set_border_width(14)
        area.set_spacing(8)
        note = Gtk.Label(label="Kopyalayıp bir ajanın mesaj alanına yapıştır. Açık oturumun sistem ayarı değişmez.",
                         xalign=0, wrap=True)
        area.pack_start(note, False, False, 0)
        scroll = Gtk.ScrolledWindow()
        view = Gtk.TextView(editable=False, wrap_mode=Gtk.WrapMode.WORD_CHAR)
        view.set_left_margin(8)
        view.set_right_margin(8)
        view.get_buffer().set_text(text)
        scroll.add(view)
        area.pack_start(scroll, True, True, 0)
        dialog.show_all()
        if dialog.run() == Gtk.ResponseType.OK:
            clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            clipboard.set_text(text, -1)
            clipboard.store()
            status.set_text("Oturum hatırlatıcısı kopyalandı.")
        dialog.destroy()

    reminder_button.connect("clicked", show_reminder)

    def choose_setup_mode(setup=False):
        if not setup:
            return "normal", None
        dialog = Gtk.MessageDialog(
            transient_for=win, modal=True, message_type=Gtk.MessageType.QUESTION,
            text="Neyi kurmak istiyorsun?")
        dialog.set_title("Kurulum seçenekleri")
        dialog.format_secondary_text(
            "Ajanın normal izin kontrolleri açık kalır. Yalnızca işaretlediğin yollar "
            "kurulum isteğine eklenir.")
        dialog.add_button("Vazgeç", Gtk.ResponseType.CANCEL)
        dialog.add_button("Normal aç", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        group = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        group.set_margin_top(12)
        pi = Gtk.CheckButton(label="Pi + NVIDIA")
        evren = Gtk.CheckButton(label="EVREN + DeepSeek (DSH CLI ve Web)")
        for item in (pi, evren):
            group.pack_start(item, False, False, 0)
        dialog.get_message_area().pack_start(group, False, False, 0)

        def update_choices(*_):
            dialog.set_response_sensitive(Gtk.ResponseType.OK, pi.get_active() or evren.get_active())

        pi.connect("toggled", update_choices)
        evren.connect("toggled", update_choices)
        update_choices()
        group.show_all()
        response = dialog.run()
        selected = (pi.get_active(), evren.get_active())
        selection = {(True, False): "pi", (False, True): "evren", (True, True): "both"}.get(selected)
        dialog.destroy()
        return ("normal", selection) if response == Gtk.ResponseType.OK and selection else (None, None)

    def confirm_pi_folder(folder):
        dialog = Gtk.MessageDialog(
            transient_for=win, modal=True, message_type=Gtk.MessageType.WARNING,
            text="Pi · NVIDIA yalnız güvenilir klasörde açılmalı")
        dialog.set_title("Pi · NVIDIA güvenilir klasör")
        dialog.format_secondary_text(f"{folder}\n\n{PI_TRUST_NOTICE}")
        dialog.add_button("Vazgeç", Gtk.ResponseType.CANCEL)
        dialog.add_button("Bu klasörde aç", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        accepted = dialog.run() == Gtk.ResponseType.OK
        dialog.destroy()
        return accepted

    def install_tool(button, provider):
        is_pi = provider == "pi"
        title = "Pi" if is_pi else "dsh"
        action = install_pi_action if is_pi else install_dsh_action
        detail = install_detail if is_pi else evren_detail
        page = install_pi_page if is_pi else evren_setup
        version = "22.19" if is_pi else "24.9"
        command = pi_install_command() if is_pi else dsh_install_command()
        if not command:
            detail.set_text(f"Node.js {version} veya üzeri ve npm gerekli. Önce alttaki rehberi aç.")
            action.set_sensitive(False)
            return
        action.set_sensitive(False)
        detail.set_text(f"{title} kuruluyor… Anahtarların bu kurulumda kullanılmaz.")
        try:
            # npm should not inherit app credentials or project-specific settings.
            env = {k: os.environ[k] for k in ("PATH", "LANG", "LC_ALL", "TMPDIR") if k in os.environ}
            workdir = tempfile.TemporaryDirectory()
            env["HOME"] = workdir.name
            child = subprocess.Popen(command, cwd=workdir.name, env=env, stdin=subprocess.DEVNULL,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            detail.set_text("Kurulum başlatılamadı. Alttaki rehberden manuel kurulumu aç.")
            action.set_sensitive(True)
            return

        def check_install():
            result = child.poll()
            if result is None:
                return GLib.SOURCE_CONTINUE
            ready = result == 0 and installed_package_ready(
                pi_prefix() if is_pi else dsh_prefix(), "pi" if is_pi else "dsh",
                PI_PACKAGE if is_pi else DSH_PACKAGE, env)
            workdir.cleanup()
            action.set_sensitive(True)
            if ready:
                status.set_text("Pi kuruldu. Şimdi Pi · NVIDIA’ya tıkla." if is_pi else "dsh kuruldu. Şimdi DSH CLI veya DSH Web’e tıkla.")
                if right.get_visible_child() is page:
                    right.set_visible_child(empty)
            else:
                detail.set_text("Kurulum tamamlanmadı. Rehberden manuel kurulumu aç veya tekrar dene.")
            return GLib.SOURCE_REMOVE

        GLib.timeout_add(220, check_install)

    install_pi_action.connect("clicked", install_tool, "pi")
    install_dsh_action.connect("clicked", install_tool, "dsh")

    def open_session(button, role):
        if role in pages and role in running:
            select_button(button)
            right.set_visible_child(pages[role])
            status.set_text("Açık oturuma dönüldü; kurulum yeniden gönderilmedi."
                            if role.startswith("setup-") else button.get_label())
            pages[role].get_child().grab_focus()
            return
        if role in ("evren", "evren-cli") and not smoke_terminal:
            state = key_file_status()["EVREN_API_KEY"]
            binary = dsh_binary() if state == "Kayıtlı" else None
            # Do not launch a different global version against the pinned profile.
            try:
                version = subprocess.check_output([binary, "--version"], text=True, timeout=1.5,
                                                  stderr=subprocess.DEVNULL).strip() if binary else ""
            except (OSError, subprocess.SubprocessError):
                version = ""
            if state != "Kayıtlı" or version != "0.2.2-rc.5":
                select_button(button)
                right.set_visible_child(evren_setup)
                install_dsh_action.set_visible(state == "Kayıtlı" and version != "0.2.2-rc.5")
                open_evren_key.set_visible(state != "Kayıtlı")
                if install_dsh_action.get_sensitive():
                    evren_detail.set_text("Önce EVREN anahtarını kaydet." if state != "Kayıtlı" else
                                          "dsh’yi kur, ardından istediğin DSH satırına tekrar tıkla.")
                return
        if role == "pi" and not pi_binary():
            select_button(button)
            right.set_visible_child(install_pi_page)
            if install_pi_action.get_sensitive():
                install_detail.set_text("Claude veya Codex gerekmez. Kurulum yalnız bu kullanıcıya yapılır.")
            return
        if role == "pi" and not shutil.which("tmux"):
            status.set_text("Pi · NVIDIA için sisteminin paket yöneticisinden tmux kur.")
            return
        agent = agent_for(role)
        tmux_target = tmux_role(role)
        attachment, selected_name, identified = resolve_session(tmux_target)
        if attachment == "blocked":
            status.set_text(("Asıl ad ve Atölye’ye ayrılan ad başka oturumlara ait. "
                             if agent else "Bu oturum Atölye oturumu olarak doğrulanamadı. ") +
                            "Bağlanılmadı; mevcut oturumlar değiştirilmedi.")
            return
        existing = attachment == "trusted"
        setup = role in ("setup-claude", "setup-codex")
        folder = chooser.get_filename() or (str(Path.home()) if setup or existing or smoke_terminal or role in ("evren", "terminal") else None)
        if not folder or not Path(folder).is_dir():
            status.set_text("Soldaki klasör seçiciden bir proje klasörü seç.")
            chooser.grab_focus()
            return
        if agent and not existing and not shutil.which(agent):
            status.set_text(f"{agent.capitalize()} bulunamadı. İlk kullanım için Pi · NVIDIA’yı seçebilirsin.")
            return
        if role == "pi" and not existing and not smoke_terminal:
            if not confirm_pi_folder(folder):
                status.set_text("Pi açılmadı.")
                return
        mode, setup_selection = ("existing", None) if existing else (
            choose_setup_mode(setup=setup) if agent else ("normal", None))
        if mode is None:
            return
        if role in pages:
            right.remove(pages.pop(role))
        terminal = Vte.Terminal()
        terminal.set_scrollback_lines(5000)
        select_button(button)
        scroller = Gtk.ScrolledWindow()
        scroller.add(terminal)
        pages[role] = scroller
        right.add_named(scroller, role)
        scroller.show_all()
        right.set_visible_child(scroller)
        terminal.grab_focus()
        running.add(role)
        label = button.get_label()
        status.set_text("Açık oturuma bağlanılıyor; kurulum gönderilmeyecek."
                        if existing and role.startswith("setup-")
                        else label)
        if attachment == "alternate":
            status.set_text(f"Asıl ad başka bir oturuma ait. Dokunulmadı; Atölye hedefi: {selected_name}.")
        elif existing and selected_name in TMUX_ALTERNATES.values():
            status.set_text(f"Atölye oturumuna bağlanılıyor: {selected_name}. Kurulum yeniden gönderilmeyecek.")
        terminal.connect("child-exited", lambda *_: process_closed(role))
        terminal.connect("contents-changed", terminal_activity, role)
        terminal_activity(terminal, role)

        def spawned(_terminal, _pid, error, *_):
            if error:
                status.set_text("Oturum açılamadı.")
                process_closed(role)
            elif tmux_target:
                def refresh_folder():
                    if selected_role == role and role in running:
                        show_session_folder(role)
                    return GLib.SOURCE_REMOVE
                GLib.timeout_add(320, refresh_folder)
        if role == "evren":
            folder = str(Path.home())
        expected_id = identified[1] if identified and (agent or role == "pi") else None
        command = note_shell("Test terminali") if smoke_terminal and role == "evren" else (
            session_command(role, mode, setup_selection, session_id=expected_id))
        terminal.spawn_async(Vte.PtyFlags.DEFAULT, folder, command, None,
                             GLib.SpawnFlags.DEFAULT, None, None, -1, None, spawned, None)

    def close_session(_button, role, label):
        agent = tmux_role(role)
        _, resolved_name, target = resolve_session(agent)
        if role not in running and not target:
            status.set_text("Kapatılacak açık oturum yok.")
            if role in pages:
                right.remove(pages.pop(role))
            return
        name = resolved_name if target else label
        dialog = Gtk.MessageDialog(transient_for=win, modal=True,
                                   message_type=Gtk.MessageType.WARNING,
                                   text=f"{name} kapatılsın mı?")
        dialog.format_secondary_text("Oturum kapanır ve içindeki çalışan işler durabilir.")
        dialog.add_button("Vazgeç", Gtk.ResponseType.CANCEL)
        dialog.add_button("Oturumu kapat", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        response = dialog.run()
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            return
        if target:
            if resolve_session(agent)[1:] != (resolved_name, target):
                status.set_text("Oturum değişti. Hiçbir oturum kapatılmadı.")
                return
            try:
                result = subprocess.run([target[0], "kill-session", "-t", target[1]],
                                        capture_output=True, timeout=2)
            except (OSError, subprocess.TimeoutExpired):
                status.set_text("tmux oturumu kapatılamadı.")
                return
            if result.returncode:
                status.set_text("tmux oturumu kapatılamadı.")
                return
        roles = [item for _, item in OPTIONS if tmux_role(item) == agent] if target else [role]
        for item in roles:
            page = pages.pop(item, None)
            process_closed(item)
            if page is not None:
                page.destroy()
        if not right.get_visible_child():
            right.set_visible_child(empty)
        if right.get_visible_child() is empty:
            select_button(None)
        status.set_text(f"{name} kapatıldı.")

    key_buttons = {}
    key_dots = {}

    def key_state_color(label, state):
        fg = label.get_style_context().get_color(Gtk.StateFlags.NORMAL)
        dark = 0.2126 * fg.red + 0.7152 * fg.green + 0.0722 * fg.blue > 0.55
        if state == "Kayıtlı":
            return "#62DEA0" if dark else "#087546"
        if state == "Okunamadı":
            return "#F5BE64" if dark else "#8A5600"
        return None

    def style_key_state(label, state, name=None, dot=False):
        color = key_state_color(label, state)
        if dot:
            color = color or "#343943"
            label.set_markup(f'<span foreground="{color}">●</span>')
            label.set_tooltip_text(f"{name} anahtarı: {state}")
        else:
            status_text = GLib.markup_escape_text(state)
            if color:
                status_text = f'<span foreground="{color}" weight="semibold">{status_text}</span>'
            prefix = f"{GLib.markup_escape_text(name)}: " if name else ""
            label.set_markup(prefix + status_text)

    def update_key_buttons():
        for variable, state in key_file_status().items():
            if variable in key_buttons:
                name = PROVIDERS[variable][0]
                description = f"{name} anahtarı: {state}"
                key_buttons[variable].set_tooltip_text(description)
                key_buttons[variable].get_accessible().set_description(description)
                style_key_state(key_dots[variable], state, name, dot=True)

    def key_settings(_button, variable):
        name, _ = PROVIDERS[variable]
        dialog = Gtk.Dialog(title=f"{name} anahtarı", transient_for=win, modal=True)
        dialog.add_button("Vazgeç", Gtk.ResponseType.CANCEL)
        dialog.add_button("Kaydet", Gtk.ResponseType.OK)
        area = dialog.get_content_area()
        area.set_spacing(10)
        area.set_border_width(16)
        detail = ("Yalnız Atölye'den açılan Pi'ye verilir." if name == "NVIDIA" else
                  "Yalnız EVREN · DSH CLI ve DSH Web’de kullanılır.")
        text = Gtk.Label(label="Anahtar proje dışında yerel .env dosyasında tutulur.\n" + detail, xalign=0)
        entry = Gtk.Entry(visibility=False)
        entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        entry.set_placeholder_text("nvapi-…" if name == "NVIDIA" else "EVREN API anahtarı")
        entry.set_activates_default(True)
        dialog.set_default_response(Gtk.ResponseType.OK)
        warning = Gtk.Label(xalign=0)
        saved_state = Gtk.Label(xalign=0)
        style_key_state(saved_state, key_file_status()[variable])
        if name == "NVIDIA":
            area.pack_start(Gtk.LinkButton.new_with_label(
                "https://build.nvidia.com/moonshotai/kimi-k3_1-pro", "NVIDIA’da API anahtarı al"), False, False, 0)
        help_link = Gtk.LinkButton.new_with_label(FAQ_URL + "#anahtar-kaydedilemiyor-ne-yapmalıyım", "Anahtar kaydetme yardımı")
        for widget in (text, saved_state, entry, warning, help_link):
            area.pack_start(widget, False, False, 0)
        dialog.show_all()
        while dialog.run() == Gtk.ResponseType.OK:
            try:
                save_key(entry.get_text().strip(), variable)
            except ValueError as exc:
                warning.set_text(str(exc))
            except OSError:
                warning.set_text("Ayar dosyasına yazılamadı. Durum “Okunamadı” ise alttaki yardıma bak.")
            else:
                status.set_text(f"{name} anahtarı kaydedildi.")
                update_key_buttons()
                break
        entry.set_text("")
        dialog.destroy()

    icon_settings = session_icons()

    def choose_icon(button, role, default):
        dialog = Gtk.Dialog(title="Simgeyi değiştir", transient_for=win, modal=True)
        dialog.add_button("Vazgeç", Gtk.ResponseType.CANCEL)
        dialog.add_button("Varsayılana dön", Gtk.ResponseType.REJECT)
        area = dialog.get_content_area()
        area.set_border_width(16)
        grid = Gtk.Grid(row_spacing=8, column_spacing=8)
        area.add(grid)
        for index, (label, icon) in enumerate(ICONS):
            item = Gtk.Button()
            item.set_tooltip_text(label)
            item.get_accessible().set_name(label)
            image = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG)
            image.set_pixel_size(24)
            item.set_image(image)
            item.set_size_request(52, 46)
            item.connect("clicked", lambda _item, response: dialog.response(response), 1000 + index)
            grid.attach(item, index % 3, index // 3, 1, 1)
        dialog.show_all()
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.REJECT:
            icon = None
        elif 1000 <= response < 1000 + len(ICONS):
            icon = ICONS[response - 1000][1]
        else:
            return
        try:
            save_session_icon(role, icon)
        except OSError:
            status.set_text("Simge kaydedilemedi.")
            return
        set_row_icon(button, icon or default)

    def copy_session_identity(_item, role):
        agent = tmux_role(role)
        _, identity, target = resolve_session(agent)
        if not target:
            status.set_text("Oturum kapalı. Önce oturumu aç.")
            return
        clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        clipboard.set_text(identity, -1)
        clipboard.store()
        path = session_pane_path(target)
        suffix = f" · {Path(path).name or '/'}" if path else ""
        status.set_text(f"{identity} panoya kopyalandı{suffix}.")
        status.set_tooltip_text(path)

    def icon_menu(button, event, role, default):
        menu = Gtk.Menu()
        menu.attach_to_widget(button, None)
        item = Gtk.MenuItem(label="Simgeyi değiştir")
        item.connect("activate", lambda *_: choose_icon(button, role, default))
        menu.append(item)
        agent = tmux_role(role)
        copy = Gtk.MenuItem(label="Oturum kimliğini kopyala")
        target = named_session(agent)
        copy.set_sensitive(bool(target))
        if target:
            path = session_pane_path(target)
            if path:
                copy.set_tooltip_text("Açık panelin klasörü: " + path)
        else:
            copy.set_tooltip_text("Önce oturumu aç." if agent else "Bu satırın bir tmux oturum kimliği yok.")
        copy.connect("activate", copy_session_identity, role)
        menu.append(copy)
        menu.connect("selection-done", lambda *_: menu.destroy())
        menu.show_all()
        if event is None:
            menu.popup_at_widget(button, Gdk.Gravity.SOUTH_WEST, Gdk.Gravity.NORTH_WEST, None)
        else:
            menu.popup_at_pointer(event)
        return True

    def right_click(button, event, role, default):
        if event.button != 3:
            return False
        return icon_menu(button, event, role, default)

    for index, (label, role) in enumerate(OPTIONS):
        if index == 2:
            left.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 4)
        default = "system-run-symbolic" if index < 2 else "utilities-terminal-symbolic"
        button = row_button(label, icon_settings.get(role, default), setup=index < 2)
        buttons_by_role[role] = button
        button.connect("clicked", open_session, role)
        button.connect("button-press-event", right_click, role, default)
        button.connect("popup-menu", lambda widget, r, d: icon_menu(widget, None, r, d), role, default)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        dot = Gtk.Label()
        dots[role] = dot
        indicate(role, "closed")
        close = Gtk.Button(label="×")
        close.get_style_context().add_class("aa-close")
        close.set_tooltip_text(f"{label}: oturumu kapat")
        close.get_accessible().set_name(f"{label}: oturumu kapat")
        close.set_relief(Gtk.ReliefStyle.NONE)
        close.connect("clicked", close_session, role, label)
        row.pack_start(button, True, True, 0)
        row.pack_start(close, False, False, 0)
        row.pack_start(dot, False, False, 0)
        left.pack_start(row, False, False, 0)
        controls.append(button)
    left.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 4)


    for variable, (name, _) in PROVIDERS.items():
        button = row_button(f"{name} anahtarı", "dialog-password-symbolic")
        button.connect("clicked", key_settings, variable)
        key_buttons[variable] = button
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        dot = Gtk.Label()
        key_dots[variable] = dot
        row.pack_start(button, True, True, 0)
        row.pack_start(dot, False, False, 0)
        keys_group.pack_start(row, False, False, 0)
        controls.append(button)

    open_evren_key.connect("clicked", key_settings, "EVREN_API_KEY")
    update_key_buttons()

    def show_key_file(_button):
        dialog = Gtk.Dialog(title="Atölye anahtarları", transient_for=win, modal=True)
        dialog.add_button("Kapat", Gtk.ResponseType.CLOSE)
        dialog.add_button("NVIDIA’yı düzenle", 1001)
        dialog.add_button("EVREN’i düzenle", 1002)
        area = dialog.get_content_area()
        area.set_spacing(8)
        area.set_border_width(16)
        description = Gtk.Label(label="Atölye’nin kullandığı dosya bu. Projede .env oluşturman gerekmiyor.", xalign=0, wrap=True)
        file_path = Gtk.Label(label=str(config_dir() / ".env"), xalign=0, selectable=True)
        for widget in (description, file_path):
            area.pack_start(widget, False, False, 0)
        for variable, state in key_file_status().items():
            label = Gtk.Label(xalign=0)
            style_key_state(label, state, PROVIDERS[variable][0])
            area.pack_start(label, False, False, 0)
        dialog.show_all()
        response = dialog.run()
        dialog.destroy()
        target = {1001: "NVIDIA_API_KEY", 1002: "EVREN_API_KEY"}.get(response)
        if target:
            key_buttons[target].clicked()

    open_keys.connect("clicked", show_key_file)
    button = row_button("Atölye anahtarları (.env)", "dialog-password-symbolic")
    button.connect("clicked", show_key_file)
    left.pack_start(button, False, False, 0)
    controls.append(button)
    legend = Gtk.Label(xalign=0, wrap=True)
    legend.set_markup('● Kapalı    <span foreground="#36a86b">●</span> Açık\n'
                      '<span foreground="#3987f7">●</span> Terminal etkinliği')
    legend.get_style_context().add_class("aa-caption")
    left.pack_end(legend, False, False, 5)
    left.pack_start(status, False, False, 10)
    win.show_all()
    return win, controls, right


def main():
    if sys.argv[1:] == ["--version"]:
        print(source_version())
        return 0
    if sys.argv[1:] == ["--pi-terminal"]:
        return pi_terminal()
    if sys.argv[1:2] == ["--pi-tmux"] and len(sys.argv) <= 3:
        return pi_tmux(sys.argv[2] if len(sys.argv) == 3 else None)
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("Vte", "2.91")
        from gi.repository import Gtk, Vte, Gio, GLib
    except (ImportError, ValueError):
        print("Ajan Atölyesi için Python GI, GTK 3 ve VTE 2.91 gerekli.", file=sys.stderr)
        return 1
    GLib.set_prgname("ajan-atolyesi")
    if not Gtk.init_check()[0]:
        print("Pencereyi grafik masaüstü oturumunda aç.", file=sys.stderr)
        return 1
    smoke = sys.argv[1:] == ["--check-terminal"]
    window, controls, stack = make_window(Gtk, Vte, Gio, GLib, smoke_terminal=smoke)
    if sys.argv[1:] in (["--check-ui"], ["--check-terminal"]):
        assert [w.get_label() for w in controls] == [name for name, _ in OPTIONS] + ["NVIDIA anahtarı", "EVREN anahtarı", "Atölye anahtarları (.env)"]
        for button in controls[:len(OPTIONS)]:
            row = button.get_parent().get_children()
            assert row[0] is button and row[1].get_label() == "×" and isinstance(row[2], Gtk.Label)
            assert button.get_style_context().has_class("aa-row")
            assert button.get_image().get_margin_end() == 8
        keys_group = controls[len(OPTIONS)].get_parent().get_parent()
        rows = [item.get_children() for item in keys_group.get_children()]
        assert [row[0].get_label() for row in rows] == ["NVIDIA anahtarı", "EVREN anahtarı"]
        assert all(isinstance(row[1], Gtk.Label) and row[1].get_text() == "●" for row in rows)
        assert keys_group.get_parent().get_children()[1] is keys_group
        assert [role for _, role in OPTIONS[2:]] == ["codex", "claude", "pi", "evren-cli", "evren", "terminal"]
        evren_button = controls[next(i for i, (_, role) in enumerate(OPTIONS) if role == "evren")]
        if smoke:
            evren_button.clicked()
            terminal = stack.get_visible_child().get_child()
            loop = GLib.MainLoop()
            GLib.timeout_add(700, lambda: (loop.quit(), False)[1])
            loop.run()
            assert isinstance(terminal, Vte.Terminal) and terminal.get_pty() is not None
        else:
            evren_button.clicked()
            assert stack.get_visible_child_name() in ("evren-setup", "evren")
            assert evren_button.get_style_context().has_class("aa-selected")
        window.hide()
        print("GTK: sol oturum listesi ve terminal paneli doğrulandı.")
        return 0
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
