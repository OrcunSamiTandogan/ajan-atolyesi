#!/usr/bin/env bash
set -euo pipefail
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
render_setup_prompt() {
  local selection=$1
  case "$selection" in pi|evren|both|ask) ;; *) return 2 ;; esac
  cat "$here/../KURULUM-PROMPTU.md" || return
  if [[ "$selection" == ask ]]; then
    printf '\nSeçim belirtilmedi. Pi, DSH veya ikisini mi istediğini sor. Yanıt gelmeden kurma.\n'
    return
  fi
  printf '\nKullanıcının seçimi kesin; tekrar seçim sorma. Yalnız aşağıdaki maddeleri uygula.\n'
  if [[ "$selection" == pi || "$selection" == both ]]; then
    printf '%s\n' '- Pi: Node.js 22.19+, npm ve tmux. Kurulu aracı pi --version ile kontrol et. Pi sürümü ve kurulum için https://docs.pi.dev/latest/quickstart. Sonraki adım: NVIDIA anahtarı → Kaydet → proje seç → Pi. tmux hedefi: aa-pi.'
  fi
  if [[ "$selection" == evren || "$selection" == both ]]; then
    printf '%s\n' '- DSH (CLI ve Web): Node.js 24.9+ ve npm. DSH CLI için tmux. Kurulu aracı dsh --version ile kontrol et. dsh sürümü ve kurulum için https://github.com/deepseek-ai/deepseek-harness/tree/master/apps/cli. Sonraki adım: EVREN anahtarı → Kaydet → DSH CLI veya DSH Web. CLI tmux hedefi: aa-evren-cli.'
  fi
}
if [[ ${1:-} == --print-setup-prompt ]]; then
  [[ $# == 2 ]] || exit 2
  render_setup_prompt "$2"
  exit
fi
phase=attach
if [[ ${1:-} == --pane ]]; then phase=pane; shift; fi
case "${1:-}" in
  claude) session=aa-claude; guide=https://code.claude.com/docs/en/setup ;;
  codex) session=aa-codex; guide=https://learn.chatgpt.com/docs/auth ;;
  *) printf 'Kullanım: ajan-kur {claude|codex} [normal|existing] [setup|plain] [pi|evren|both]\n'; exit 2 ;;
esac
mode=${2:-normal}
case "$mode" in normal|existing) ;; *) exit 2 ;; esac
if [[ "$phase" == pane ]]; then
  [[ "$mode" != existing ]] || exit 2
  status=0
  flags=()
  agent=$3
  case "${4:-setup}" in
    setup) prompt="$(render_setup_prompt "${5:-ask}")"; flags+=("$prompt") ;;
    plain) [[ -z ${5:-} ]] || exit 2 ;;
    *) exit 2 ;;
  esac
  "$agent" "${flags[@]}" || status=$?
  printf '\nAjan kapandı (çıkış %s). Oturum açık.\n' "$status"
  exec /bin/bash --noprofile --norc -i
fi
hold() { exec /bin/bash --noprofile --norc -i; }
owner=ajan-atolyesi-public-v1
kind=${3:-setup}
selection=${4:-}
if [[ "$mode" == existing ]]; then
  [[ "$kind" == plain ]] || exit 2
  expected=$selection
  [[ -z "$expected" || "$expected" =~ ^\$[0-9]+$ ]] || exit 2
  selection=
fi
case "$kind:$selection" in setup:|setup:pi|setup:evren|setup:both|plain:) ;; *) exit 2 ;; esac

canonical=$session
alternate=$canonical-atolye

session_id() {
  local exact=$1
  local listed name id other found=''
  listed="$(tmux list-sessions -F '#{session_name} #{session_id}' 2>/dev/null)" || return 1
  while IFS=' ' read -r name id other; do
    if [[ "$name" == "$exact" && "$id" =~ ^\$[0-9]+$ && -z "$other" ]]; then
      [[ -z "$found" ]] || return 1
      found=$id
    fi
  done <<< "$listed"
  [[ -n "$found" ]] || return 1
  printf '%s\n' "$found"
}
is_owned() {
  local id=$1
  [[ "$(tmux show-environment -t "$id" AA_ATOLYE_OWNER 2>/dev/null)" == "AA_ATOLYE_OWNER=$owner" ]] &&
  [[ "$(tmux show-environment -t "$id" AA_SETUP_MODE 2>/dev/null)" == 'AA_SETUP_MODE=normal' ]]
}
resolve_session() {
  local canonical_id alternate_id
  canonical_id="$(session_id "$canonical")" || canonical_id=
  alternate_id="$(session_id "$alternate")" || alternate_id=
  session=$canonical
  resolved_id=
  if [[ -n "$canonical_id" ]] && is_owned "$canonical_id"; then
    resolved_id=$canonical_id
  elif [[ -n "$alternate_id" ]] && is_owned "$alternate_id"; then
    session=$alternate
    resolved_id=$alternate_id
  elif [[ -n "$canonical_id" ]]; then
    session=$alternate
    [[ -z "$alternate_id" ]] || return 1
  fi
}
attach_checked() {
  local id
  if ! id="$(session_id "$session")" || ! is_owned "$id" || [[ -n ${expected:-} && "$id" != "$expected" ]]; then
    printf 'Mevcut %s oturumu Atölye’nin normal oturumu olarak doğrulanamadı. Bağlanılmadı.\n' "$session" >&2
    exit 1
  fi
  if [[ -n ${TMUX:-} ]]; then exec tmux switch-client -t "$id"; fi
  exec tmux attach-session -t "$id"
}
if [[ "$mode" == existing ]]; then
  command -v tmux >/dev/null || exit 1
  if ! resolve_session || [[ -z "$resolved_id" ]]; then
    printf 'Doğrulanmış bir Atölye oturumu bulunamadı. Bağlanılmadı.\n' >&2
    exit 1
  fi
  attach_checked
fi
if ! command -v tmux >/dev/null; then
  if ! command -v apt-get >/dev/null || ! command -v sudo >/dev/null; then
    printf 'Önce sisteminin paket yöneticisinden tmux kurup bu düğmeye yeniden bas.\n'
    hold
  fi
  printf 'tmux eksik. Ubuntu paketlerinden kurulsun mu? [e/H] '
  read -r answer || exit 1
  case "$answer" in e|E|evet|Evet) ;; *) exit 0 ;; esac
  sudo apt-get install tmux || hold
  hash -r
fi
if ! resolve_session; then
  printf '%s ve %s adları başka oturumlara ait. Bağlanılmadı; bu oturumlara dokunulmadı.\n' "$canonical" "$alternate" >&2
  exit 1
fi
if [[ -n "$resolved_id" ]]; then
  expected=$resolved_id
  attach_checked
fi
if ! agent=$(command -v "$1"); then
  printf '%s bulunamadı. Önce resmî aracı kur: %s\n' "$1" "$guide"
  hold
fi
if [[ "$session" == "$alternate" ]]; then
  printf '%s başka bir oturuma ait. Bu oturuma dokunulmadı; Atölye hedefi: %s.\n' "$canonical" "$session"
fi
if [[ -n ${TMUX:-} ]]; then
  tmux new-session -d -s "$session" -c "$PWD" -e "AA_SETUP_MODE=normal" -e "AA_ATOLYE_OWNER=$owner" "$here/ajan-kur" --pane "$1" "$mode" "$agent" "$kind" "$selection"
  attach_checked
fi
exec tmux new-session -s "$session" -c "$PWD" -e "AA_SETUP_MODE=normal" -e "AA_ATOLYE_OWNER=$owner" "$here/ajan-kur" --pane "$1" "$mode" "$agent" "$kind" "$selection"
