#!/usr/bin/env python3
"""Read-only check of the EVREN key and target model; no model inference."""
import getpass
import json
import os
import sys
from urllib.error import HTTPError, URLError
from urllib.request import HTTPRedirectHandler, ProxyHandler, Request, build_opener

MODEL = "deepseek-v4.1-flash"
URL = "https://evren-llmapi.ssyz.org.tr/v1/models"


class NoRedirect(HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def check_model(key, opener=None):
    if not key or any(not 33 <= ord(c) <= 126 for c in key):
        print("EVREN anahtarını boşluk olmadan gir.", file=sys.stderr)
        return 2
    if opener is None:
        opener = build_opener(NoRedirect(), ProxyHandler({}))
    request = Request(URL, headers={"Authorization": "Bearer " + key,
                                    "Accept": "application/json"})
    try:
        with opener.open(request, timeout=10) as response:
            models = json.loads(response.read(1_000_000))["data"]
        found = any(m.get("id") == MODEL for m in models if isinstance(m, dict))
    except HTTPError as exc:
        print(f"EVREN bağlantısı kabul edilmedi (HTTP {exc.code}).", file=sys.stderr)
        return 1
    except (URLError, TimeoutError, ValueError, KeyError, TypeError, OSError):
        print("EVREN model listesi okunamadı.", file=sys.stderr)
        return 1
    if not found:
        print("Anahtar kabul edildi, ama DeepSeek V4.1 Flash listede yok.")
        return 1
    print("EVREN anahtarı kabul edildi. DeepSeek V4.1 Flash listede.")
    return 0


def main():
    key = os.environ.get("EVREN_API_KEY")
    if not key:
        if not sys.stdin.isatty():
            print("Komutu terminalde çalıştır; anahtar ekranda görünmez.", file=sys.stderr)
            return 2
        key = getpass.getpass("EVREN anahtarı: ")
    return check_model(key)


if __name__ == "__main__":
    raise SystemExit(main())
